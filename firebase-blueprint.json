{
  "collections": [
    {
      "name": "gifts",
      "description": "Gifts and effects store items",
      "fields": [
        { "name": "title", "type": "string" },
        { "name": "price", "type": "number" },
        { "name": "vipPrice", "type": "number" },
        { "name": "exclusivePrice", "type": "number" },
        { "name": "videoUrl", "type": "string" },
        { "name": "posterUrl", "type": "string" },
        { "name": "category", "type": "string" },
        { "name": "theme", "type": "string" },
        { "name": "effectType", "type": "string" },
        { "name": "author", "type": "map" },
        { "name": "formats", "type": "array" },
        { "name": "tags", "type": "array" },
        { "name": "downloadsCount", "type": "number" },
        { "name": "favoritesCount", "type": "number" },
        { "name": "createdAt", "type": "string" }
      ],
      "access": "read:all, write:authenticated"
    },
    {
      "name": "deliveries",
      "description": "Purchased deliveries history and orders",
      "fields": [
        { "name": "orderId", "type": "string" },
        { "name": "giftId", "type": "string" },
        { "name": "giftTitle", "type": "string" },
        { "name": "buyerContact", "type": "string" },
        { "name": "purchaseDate", "type": "string" },
        { "name": "price", "type": "number" }
      ],
      "access": "read:all, write:authenticated"
    },
    {
      "name": "employees",
      "description": "Employee and designer accounts created by admin",
      "fields": [
        { "name": "name", "type": "string" },
        { "name": "email", "type": "string" },
        { "name": "role", "type": "string" },
        { "name": "whatsapp", "type": "string" },
        { "name": "password", "type": "string" }
      ],
      "access": "read:all, write:authenticated"
    },
    {
      "name": "banners",
      "description": "Hero banners managed from the dashboard with dimensions specifications",
      "fields": [
        { "name": "title", "type": "string" },
        { "name": "subtitle", "type": "string" },
        { "name": "badge", "type": "string" },
        { "name": "imageUrl", "type": "string" },
        { "name": "btnText", "type": "string" },
        { "name": "dimensionsNote", "type": "string" },
        { "name": "isActive", "type": "boolean" }
      ],
      "access": "read:all, write:authenticated"
    }
  ]
}
