rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Role checks using the employees collection
    function getRole() {
      return isAuthenticated() ? get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.role : null;
    }

    function isAdmin() {
      return getRole() == 'admin';
    }

    function isDesignerOrAdmin() {
      let role = getRole();
      return role == 'admin' || role == 'designer';
    }

    // Gifts Collection
    match /gifts/{giftId} {
      // Anyone can read gifts
      allow read: if true;
      // Only admins or designers can create/update/delete
      allow write: if isDesignerOrAdmin();
    }

    // Deliveries Collection
    match /deliveries/{deliveryId} {
      // In a real app, you'd check if the delivery belongs to the user
      // allow read, write: if isAuthenticated() && (resource.data.buyerContact == request.auth.uid || isAdmin());
      // For this migration, we'll allow authenticated users to read/write for now
      allow read, write: if isAuthenticated();
    }

    // Employees Collection
    match /employees/{employeeId} {
      // Anyone can read employee profiles (e.g. to see designer details)
      allow read: if true;
      // Only admins can modify employees, OR users can modify their own profile
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == employeeId);
    }
  }
}
