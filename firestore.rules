rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    // Gifts Collection: Readable by all, writable by authenticated users
    match /gifts/{giftId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Deliveries Collection: Readable by all, writable by authenticated users
    match /deliveries/{deliveryId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Employees Collection: Readable by all, writable by authenticated users
    match /employees/{employeeId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Users / Accounts Collection: Readable by all, writable by authenticated users
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Banners Collection: Readable by all, writable by authenticated users
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Categories Collection: Readable by all, writable by authenticated users
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Site Settings Collection: Readable by all, writable by authenticated users
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
